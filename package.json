{
  "name": "oszillator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "corepack pnpm --filter @oszillator/player dev",
    "build": "corepack pnpm -r --filter './packages/**' build && corepack pnpm --filter @oszillator/player build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "corepack pnpm --filter @oszillator/player test:e2e",
    "lint": "eslint .",
    "format": "prettier . --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.0.10",
    "eslint": "^9.27.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
